            "$ref": "#/$defs/FactionRelationCandidateV1"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Relations",
          "type": "array",
          "required": true,
          "$defs": {
            "FactionRelationCandidateV1": {
              "additionalProperties": false,
              "description": "模型输出或用户编辑后的单条阵营关系候选。",
              "properties": {
                "relation_ref": {
                  "description": "仅在本次候选中使用的稳定引用，例如 relation_001。",
                  "pattern": "^relation_[0-9]{3}$",
                  "title": "Relation Ref",
                  "type": "string"
                },
                "source_faction_id": {
                  "description": "关系来源阵营业务 ID，必须来自本次输入阵营。",
                  "pattern": "^fac_[0-9]{6,}$",
                  "title": "Source Faction Id",
                  "type": "string"
                },
                "target_faction_id": {
                  "description": "关系目标阵营业务 ID，必须来自本次输入阵营。",
                  "pattern": "^fac_[0-9]{6,}$",
                  "title": "Target Faction Id",
                  "type": "string"
                },
                "relation_type": {
                  "description": "阵营关系类型。",
                  "enum": [
                    "hostile",
                    "allied",
                    "cold_war",
                    "dependent",
                    "subordinate",
                    "trade_partner",
                    "secret_cooperation",
                    "historical_enemy"
                  ],
                  "title": "Relation Type",
                  "type": "string"
                },
                "current_state": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Current State",
                  "type": "string"
                },
                "core_conflict": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Core Conflict",
                  "type": "string"
                },
                "hidden_tension": {
                  "maxLength": 2000,
                  "title": "Hidden Tension",
                  "type": "string"
                },
                "possible_change": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Possible Change",
                  "type": "string"
                },
                "intensity": {
                  "maximum": 5,
                  "minimum": 1,
                  "title": "Intensity",
                  "type": "integer"
                },
                "is_active": {
                  "description": "新生成关系固定为 true。",
                  "title": "Is Active",
                  "type": "boolean"
                }
              },
              "required": [
                "relation_ref",
                "source_faction_id",
                "target_faction_id",
                "relation_type",
                "current_state",
                "core_conflict",
                "hidden_tension",
                "possible_change",
                "intensity",
                "is_active"
