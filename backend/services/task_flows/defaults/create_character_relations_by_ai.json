      "outputs": {
        "relations": {
          "description": "仅追加到当前小说的全书级角色关系候选列表。",
          "items": {
            "$ref": "#/$defs/CharacterRelationCandidateV1"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Relations",
          "type": "array",
          "required": true,
          "$defs": {
            "CharacterRelationCandidateV1": {
              "additionalProperties": false,
              "description": "模型输出或用户编辑后的单条角色关系候选。",
              "properties": {
                "relation_ref": {
                  "description": "仅在本次候选中使用的稳定引用，如 relation_001。",
                  "pattern": "^relation_[0-9]{3}$",
                  "title": "Relation Ref",
                  "type": "string"
                },
                "source_character_id": {
                  "description": "关系源角色业务 ID，必须来自本次输入角色。",
                  "pattern": "^char_[0-9]{6,}$",
                  "title": "Source Character Id",
                  "type": "string"
                },
                "target_character_id": {
                  "description": "关系目标角色业务 ID，必须来自本次输入角色。",
                  "pattern": "^char_[0-9]{6,}$",
                  "title": "Target Character Id",
                  "type": "string"
                },
                "relation_type": {
                  "description": "关系类型。",
                  "enum": [
                    "friend",
                    "romantic",
                    "ally",
                    "rival",
                    "enemy",
                    "parent_of",
                    "mentor_of",
                    "superior_of",
                    "protector_of",
                    "debtor_to"
                  ],
                  "title": "Relation Type",
                  "type": "string"
                },
                "current_state": {
                  "description": "故事开始时双方关系的当前状态。",
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Current State",
                  "type": "string"
                },
                "core_conflict": {
                  "description": "关系中的核心矛盾。",
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Core Conflict",
                  "type": "string"
                },
                "hidden_tension": {
                  "description": "未公开或尚未爆发的深层张力。",
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Hidden Tension",
                  "type": "string"
                },
                "possible_change": {
                  "description": "跨全书可能发生的关系变化。",
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Possible Change",
                  "type": "string"
                },
                "story_value": {
                  "description": "该关系推动主线的叙事价值。",
                  "maxLength": 2000,
                  "minLength": 1,
                  "title": "Story Value",
                  "type": "string"
                },
                "intensity": {
                  "description": "关系强度，1 至 5。",
                  "maximum": 5,
                  "minimum": 1,
                  "title": "Intensity",
                  "type": "integer"
                },
                "is_active": {
                  "description": "新生成关系固定为 true。",
                  "title": "Is Active",
                  "type": "boolean"
                }
              },
              "required": [
                "relation_ref",
                "source_character_id",
                "target_character_id",
                "relation_type",
                "current_state",
                "core_conflict",
                "hidden_tension",
                "possible_change",
                "story_value",
                "intensity",
                "is_active"
              ],
              "title": "CharacterRelationCandidateV1",
              "type": "object"
            }
          }
        }
      },
